# Committed defaults for local development (Symfony convention).
# These values are NOT secrets. Override them in .env.local (git-ignored)
# or with real environment variables.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me_this_is_not_a_real_secret
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Default: SQLite file, used by ./start.sh (no database server needed).
# docker-compose.yml overrides DATABASE_URL to point at its MySQL service, e.g.:
# DATABASE_URL="mysql://app:app_password_change_me@db:3306/emfor?serverVersion=8.0.32&charset=utf8mb4"
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###
